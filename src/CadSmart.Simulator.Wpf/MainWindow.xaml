<Window x:Class="CadSmart.Simulator.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CadSmart 候选框原型（阶段0 UI 验证）"
        Width="520" Height="360"
        WindowStartupLocation="CenterScreen"
        Background="#1E1E1E">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="模拟 CAD 命令行 — 中文/拼音/缩写/错别字均可（↓↑ 选择，回车执行，Esc 隐藏）"
                   Foreground="#9FE1CB" FontSize="12" Margin="0,0,0,8"/>

        <TextBox Grid.Row="1" x:Name="InputBox"
                 FontSize="16" Padding="8,6"
                 Background="#2A2A2A" Foreground="#EEEEEE" BorderBrush="#444444"
                 TextChanged="OnTextChanged" PreviewKeyDown="OnPreviewKeyDown"/>

        <ListBox Grid.Row="2" x:Name="CandidateList"
                 Margin="0,4,0,0"
                 Background="#252525" BorderBrush="#3C3C3C" BorderThickness="1"
                 Foreground="#EEEEEE"
                 Visibility="Collapsed"
                 MouseDoubleClick="OnCandidateDoubleClick">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Margin="4">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Command.Id}" FontWeight="SemiBold"
                                       Foreground="#B5D4F4" Width="110"/>
                            <TextBlock Text="{Binding Command.ChineseName}" Foreground="#EEEEEE" Width="90"/>
                            <TextBlock Text="{Binding Command.Category}" Foreground="#888888" Width="80"/>
                            <TextBlock Text="{Binding Score, StringFormat={}{0:F1}}" Foreground="#9FE1CB"/>
                            <TextBlock Text="{Binding MatchedVia, StringFormat=·{0}}" Foreground="#666666" Margin="8,0,0,0"/>
                        </StackPanel>
                        <TextBlock Text="{Binding Command.ParamsHint}" Foreground="#777777" FontSize="11"
                                   Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <StackPanel Grid.Row="3" Margin="0,8,0,0">
            <TextBlock x:Name="ExecutedText" Foreground="#97C459" FontSize="12"/>
            <TextBlock x:Name="StatusText" Foreground="#666666" FontSize="11" Margin="0,4,0,0"/>
        </StackPanel>
    </Grid>
</Window>
