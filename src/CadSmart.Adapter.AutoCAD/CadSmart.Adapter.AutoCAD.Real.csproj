<Project Sdk="Microsoft.NET.Sdk">

  <!-- AutoCAD 2018 真机插件项目（R22.0 = .NET Framework 4.x + ObjectARX .NET API）。
       引用 DLL 来自远程真机拉取（lib/autocad2018/），编译产物 NETLOAD 到 AutoCAD。 -->
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>CadSmart.Adapter.AutoCAD</RootNamespace>
    <UseWPF>true</UseWPF>
    <DefineConstants>HAS_AUTOCAD</DefineConstants>
    <AssemblyName>CadSmart.Adapter.AutoCAD.Real</AssemblyName>
    <!-- 只编译真机适配器（目录里的骨架文件依赖 net8 Core 项目，不参与 net48 编译） -->
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <Description>CadSmart for AutoCAD 2018 — 真机插件（NETLOAD 后输入 CADSMARTON）</Description>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="acmgd">
      <HintPath>..\..\lib\autocad2018\acmgd.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="acdbmgd">
      <HintPath>..\..\lib\autocad2018\acdbmgd.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="accoremgd">
      <HintPath>..\..\lib\autocad2018\accoremgd.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- net48 需要：HttpClient（System.Net.Http）+ System.Text.Json + IBrowsableArray 等 -->
    <Reference Include="System.Net.Http" />
    <Reference Include="System.Web" />
    <PackageReference Include="System.Text.Json" Version="6.0.11" />
    <PackageReference Include="Microsoft.Bcl.AsyncInterfaces" Version="6.0.0" />
    <Reference Include="System.Threading.Tasks.Extensions" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="RealAdapter.cs" />
  </ItemGroup>

</Project>
